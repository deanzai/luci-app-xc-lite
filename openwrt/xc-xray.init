#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
    [ -s /etc/xc/config.json ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/xray run -c /etc/xc/config.json
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

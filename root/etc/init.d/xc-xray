#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

get_setting() {
	local key="$1"
	local def="$2"
	if [ -f /etc/xc/settings.json ]; then
		local val
		val=$(grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" /etc/xc/settings.json 2>/dev/null | head -n 1 | cut -d'"' -f4)
		if [ -n "$val" ]; then
			echo "$val"
			return 0
		fi
	fi
	echo "$def"
}

resolve_xray() {
	local src
	src="$(get_setting "core_source" "custom")"
	if [ "$src" = "builtin" ]; then
		if [ -x /usr/bin/xray ]; then
			echo "/usr/bin/xray"
			return 0
		fi
	else
		# custom mode: 优先使用自定义核心，若缺失自动回退保底至系统内置核心
		if [ -x /etc/xc/bin/xray ]; then
			echo "/etc/xc/bin/xray"
			return 0
		elif [ -x /usr/bin/xray ]; then
			echo "/usr/bin/xray"
			return 0
		fi
	fi
	return 1
}

resolve_asset_dir() {
	local src dir
	src="$(get_setting "asset_source" "custom")"
	if [ "$src" = "builtin" ]; then
		for dir in /usr/share/xray /usr/share/v2ray; do
			if [ -f "$dir/geosite.dat" ] && [ -f "$dir/geoip.dat" ]; then
				echo "$dir"
				return 0
			fi
		done
	else
		# custom mode: 优先使用自定义规则，若缺失自动回退保底至系统内置规则
		if [ -f /etc/xc/assets/geosite.dat ] && [ -f /etc/xc/assets/geoip.dat ]; then
			echo "/etc/xc/assets"
			return 0
		fi
		for dir in /usr/share/xray /usr/share/v2ray; do
			if [ -f "$dir/geosite.dat" ] && [ -f "$dir/geoip.dat" ]; then
				echo "$dir"
				return 0
			fi
		done
	fi
	return 1
}

start_service() {
	mkdir -p /etc/xc/bin /etc/xc/assets /var/log || return 1

	local xray_path asset_dir
	xray_path="$(resolve_xray 2>/dev/null)" || xray_path=""
	asset_dir="$(resolve_asset_dir 2>/dev/null)" || asset_dir=""

	if [ -z "$xray_path" ]; then
		logger -t xc-xray -p daemon.err "Core file missing: xray binary not found in /etc/xc/bin/xray or /usr/bin/xray"
		return 1
	fi

	if [ -z "$asset_dir" ]; then
		logger -t xc-xray -p daemon.err "Asset file missing: geosite.dat or geoip.dat not found in /etc/xc/assets, /usr/share/xray, /usr/share/v2ray"
		return 1
	fi

	[ -s /etc/xc/config.json ] || {
		logger -t xc-xray -p daemon.err "Config file missing or empty: /etc/xc/config.json"
		return 1
	}

	procd_open_instance
	procd_set_param command "$xray_path" run -c /etc/xc/config.json
	procd_set_param env XRAY_LOCATION_ASSET="$asset_dir"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	return 0
}

#!/bin/sh

[ -d /etc/xc ] || mkdir -p /etc/xc
[ -f /etc/xc/settings.json ] || cp /etc/xc/settings.example.json /etc/xc/settings.json 2>/dev/null
[ -f /etc/xc/nodes.json ] || echo '{"version":1,"fixed_proxy_id":null,"nodes":[]}' > /etc/xc/nodes.json
chmod +x /usr/bin/xc /usr/libexec/rpcd/luci.xc /etc/init.d/xc-xray 2>/dev/null

exit 0

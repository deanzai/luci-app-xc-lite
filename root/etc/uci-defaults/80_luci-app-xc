#!/bin/sh

[ -n "${IPKG_INSTROOT}" ] || {
	[ -d /etc/xc ] || mkdir -p /etc/xc
	[ -d /var/etc/xc ] || mkdir -p /var/etc/xc
	chmod +x /usr/bin/xc /usr/libexec/rpcd/luci.xc /etc/init.d/xc 2>/dev/null

	# 触发向 UCI 的自动平滑数据迁移
	[ -x /usr/bin/xc ] && /usr/bin/xc migrate >/dev/null 2>&1 || true

	# 遵循 UCI enabled 配置开启自启
	if [ "$(uci -q get xc.main.enabled)" != "0" ]; then
		/etc/init.d/xc enable 2>/dev/null || true
	fi
}

exit 0
